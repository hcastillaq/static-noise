{
  "$schema": "./schemas/compatibility.schema.json",
  "name": "Static Noise Compatibility Baseline",
  "baselineDate": "2026-09-16",
  "targets": {
    "ghostty": {
      "name": "Ghostty",
      "version": "1.3.1",
      "output": "dist/ghostty/static-noise",
      "template": "ghostty.template",
      "format": "ghostty-theme",
      "source": "https://ghostty.org/docs/config/reference",
      "nativeCommand": "ghostty",
      "nativeArgs": ["+validate-config", "--config-file={output}"]
    },
    "zellij-theme": {
      "name": "Zellij Theme",
      "version": "0.45.1",
      "output": "dist/zellij/static-noise.kdl",
      "template": "zellij.kdl.template",
      "format": "kdl",
      "source": "https://zellij.dev/documentation/themes",
      "nativeCommand": "zellij",
      "nativeArgs": ["--config", "/dev/null", "--config-dir", "{tempThemeDir}", "setup", "--check"]
    },
    "zellij-layout": {
      "name": "Zellij Layout",
      "version": "0.45.1",
      "output": "dist/zellij/layouts/default.kdl",
      "template": "zellij-layout.kdl.template",
      "format": "kdl",
      "source": "https://zellij.dev/documentation/creating-a-layout",
      "nativeCommand": "zellij",
      "nativeArgs": ["--config", "/dev/null", "setup", "--dump-layout", "{output}"]
    },
    "zjstatus": {
      "name": "zjstatus",
      "version": "0.25.0",
      "output": "dist/zellij/layouts/default.kdl",
      "template": "zellij-layout.kdl.template",
      "format": "zjstatus-config",
      "source": "https://github.com/dj95/zjstatus/wiki/3-%E2%80%90-Configuration",
      "nativeCommand": "zellij",
      "nativeArgs": ["--config", "/dev/null", "setup", "--dump-layout", "{output}"]
    },
    "neovim": {
      "name": "Neovim",
      "version": "0.12.5",
      "output": "dist/neovim/palette.lua",
      "template": "neovim.lua.template",
      "format": "lua",
      "source": "https://neovim.io/doc/user/lua/",
      "nativeCommand": "nvim",
      "nativeArgs": ["--headless", "-u", "NONE", "-c", "lua assert(loadfile('{output}'))()", "-c", "quit"]
    },
    "vscode": {
      "name": "VS Code Theme",
      "version": "1.137",
      "output": "dist/vscode/static-noise-color-theme.json",
      "template": "vscode.json.template",
      "format": "json",
      "source": "https://code.visualstudio.com/api/references/theme-color",
      "nativeCommand": "node",
      "nativeArgs": ["--test", "test/targets/editor-themes.test.mjs"]
    },
    "fish-fzf": {
      "name": "Fish and FZF",
      "version": "4.8.1",
      "output": "dist/fish/static-noise-colors.fish",
      "template": "fish-colors.template",
      "format": "fish",
      "source": "https://fishshell.com/docs/current/cmds/set_color.html",
      "nativeCommand": "fish",
      "nativeArgs": ["-n", "{output}"]
    },
    "starship-palette": {
      "name": "Starship Palette",
      "version": "1.26.0",
      "output": "dist/starship/static-noise-palette.toml",
      "template": "starship-palette.template",
      "format": "toml",
      "source": "https://starship.rs/config/",
      "nativeCommand": "starship",
      "nativeArgs": ["explain"]
    },
    "starship": {
      "name": "Starship Config",
      "version": "1.26.0",
      "output": "dist/starship/starship.toml",
      "template": "starship.toml.template",
      "format": "toml",
      "source": "https://starship.rs/config/",
      "nativeCommand": "starship",
      "nativeArgs": ["explain"]
    },
    "bottom": {
      "name": "bottom",
      "version": "0.14.9",
      "output": "dist/bottom/static-noise-colors.toml",
      "template": "bottom-colors.template",
      "format": "toml",
      "source": "https://clementtsang.github.io/bottom/nightly/configuration/config-file/styling/",
      "nativeCommand": "btm",
      "nativeArgs": ["--config_location", "{output}", "--help"]
    },
    "lazygit": {
      "name": "LazyGit",
      "version": "0.64.1",
      "output": "dist/lazygit/static-noise-theme.yml",
      "template": "lazygit-theme.template",
      "format": "yaml",
      "source": "https://github.com/jesseduffield/lazygit/blob/master/docs/Config.md",
      "nativeCommand": "lazygit",
      "nativeArgs": ["-ucf", "{output}", "--config"]
    },
    "delta": {
      "name": "Git Delta",
      "version": "0.19.2",
      "output": "dist/delta/static-noise.gitconfig",
      "template": "delta-theme.template",
      "format": "gitconfig",
      "source": "https://dandavison.github.io/delta/configuration.html",
      "nativeCommand": "delta",
      "nativeArgs": ["--config", "{output}", "--show-config"]
    },
    "pi": {
      "name": "Pi Coding Agent",
      "version": "0.85.1",
      "output": "dist/pi/static-noise-theme.json",
      "template": "pi-theme.json.template",
      "format": "json",
      "source": "https://pi.dev/docs/latest/themes",
      "nativeCommand": "pi",
      "nativeArgs": ["--theme", "{output}", "--version"]
    }
  }
}
