# Generated from palette.json. Do not edit generated output manually.
# ==============================================================================
# CONFIGURACIÓN DE STARSHIP (TEMA STATIC NOISE & FLAT NERD ICONS)
# ==============================================================================

palette = "static-noise"

# --- CONFIGURACIÓN GLOBAL ---
add_newline = false
command_timeout = 2000

# --- ESTRUCTURA DEL PROMPT ---
format = """
$kubernetes$docker_context$directory$git_branch$git_status$mise$nodejs$python$rust$golang$java$cmd_duration
$character
"""

# ==============================================================================
# MÓDULOS DE ENTORNO Y HERRAMIENTAS
# ==============================================================================

# --- DIRECTORY (Ruta actual) ---
[directory]
truncation_length = 3
truncate_to_repo = true
format = "[$path]($style) "
style = "bold fg:{{colors.accents.blue}}" # Blue (Identificadores y rutas)
read_only = " "
read_only_style = "bold fg:{{colors.accents.red}}" # Red (Alerta)

# --- KUBERNETES ---
[kubernetes]
disabled = false
symbol = "☸ "
format = '[$symbol$context]($style) '
style = 'bold fg:{{colors.accents.cyan}}' # Cyan (Operador / cluster activo)
detect_files = []
detect_extensions = []
detect_folders = []

# --- DOCKER CONTEXT ---
[docker_context]
disabled = false
symbol = " "
format = '[$symbol$context]($style) '
style = 'bold fg:{{colors.accents.blue}}' # Blue
only_with_files = true

# --- MISE ---
[mise]
disabled = false
symbol = " "
format = '[$symbol$tool@$version]($style) '
style = 'bold fg:{{colors.accents.purple}}' # Purple

# --- NODEJS ---
[nodejs]
symbol = " "
format = '[$symbol$version]($style) '
style = 'bold fg:{{colors.accents.green}}' # Green
detect_extensions = ["js", "ts", "tsx", "mjs", "cjs"]
detect_files = ["package.json", ".nvmrc", "bun.lockb", "pnpm-lock.yaml"]
detect_folders = ["node_modules"]

# --- PYTHON ---
[python]
symbol = " "
format = '[$symbol($version )(\((virtualenv) \))]($style) '
style = "bold fg:{{colors.accents.yellow}}" # Yellow
detect_files = [".venv", "uv.lock", "pyproject.toml", "requirements.txt"]
detect_extensions = ["py"]

# --- RUST ---
[rust]
symbol = " "
format = '[$symbol$version]($style) '
style = "bold fg:{{colors.accents.orange}}" # Orange
detect_extensions = ["rs"]
detect_files = ["Cargo.toml"]

# --- GOLANG ---
[golang]
symbol = " "
format = '[$symbol$version]($style) '
style = "bold fg:{{colors.accents.cyan}}" # Cyan
detect_extensions = ["go"]
detect_files = ["go.mod", "go.sum", "go.work"]

# --- JAVA ---
[java]
symbol = " "
format = '[$symbol$version]($style) '
style = 'bold fg:{{colors.accents.magenta}}' # Pink
detect_extensions = ["java", "class", "jar", "gradle", "pom.xml"]

# ==============================================================================
# MÓDULOS DE GIT
# ==============================================================================

[git_branch]
symbol = " "
format = '[$symbol$branch]($style) '
style = 'bold fg:{{colors.accents.purple}}' # Purple (Ramas Git)

[git_status]
format = '([$all_status$ahead_behind]($style) )'
style = 'bold fg:{{colors.accents.orange}}' # Orange (Modificaciones)
conflicted = " "
ahead = "⇡${count}"
behind = "⇣${count}"
diverged = "⇕⇡${ahead_count}⇣${behind_count}"
untracked = "?${count} "
staged = "+${count} "
modified = "!${count} "
deleted = "✘${count} "

# ==============================================================================
# UTILIDADES ADICIONALES
# ==============================================================================

# --- TIEMPO DE EJECUCIÓN ---
[cmd_duration]
min_time = 2000
format = '[ $duration]($style) '
style = 'bold fg:{{colors.accents.yellow}}' # Yellow (Duración y métricas)

# ==============================================================================
# CARÁCTER DE ENTRADA (PROMPT CHARACTER)
# ==============================================================================
[character]
success_symbol = '[->](bold fg:{{colors.accents.cyan}})' # Cyan (Foco activo)
error_symbol = '[->](bold fg:{{colors.accents.red}})'   # Red (Error)
vimcmd_symbol = '[<-](bold fg:{{colors.accents.green}})'  # Green (Modo normal Vi)

[palettes.static-noise]
void = "{{colors.base.void}}"
surface = "{{colors.base.surface}}"
foreground = "{{colors.text.foreground}}"
soft = "{{colors.text.soft}}"
muted = "{{colors.text.muted}}"
dim = "{{colors.text.dim}}"
cyan = "{{colors.accents.cyan}}"
blue = "{{colors.accents.blue}}"
purple = "{{colors.accents.purple}}"
magenta = "{{colors.accents.magenta}}"
green = "{{colors.accents.green}}"
yellow = "{{colors.accents.yellow}}"
orange = "{{colors.accents.orange}}"
red = "{{colors.accents.red}}"
