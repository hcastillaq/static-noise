# Static Noise theme for lazygit
# Generated from palette.json. Do not edit generated output manually.

gui:
  theme:
    activeBorderColor:
      - '{{colors.accents.cyan}}'
      - bold
    inactiveBorderColor:
      - '{{colors.base.borderFocus}}'
    searchingInactiveBorderColor:
      - '{{colors.base.borderFocus}}'
    searchingActiveBorderColor:
      - '{{colors.accents.orange}}'
      - bold
    optionsTextColor:
      - '{{colors.accents.cyan}}'
    selectedLineBgColor:
      - '{{colors.dim.cyan}}'
    inactiveViewSelectedLineBgColor:
      - '{{colors.base.selection}}'
    activeViewSelectedLineBgColor:
      - '{{colors.dim.cyan}}'
    inactiveViewSelectedLineFgColor:
      - '{{colors.text.muted}}'
    activeViewSelectedLineFgColor:
      - '{{colors.text.foreground}}'
    selectedRangeBgColor:
      - '{{colors.dim.blue}}'
    selectedRangeFgColor:
      - '{{colors.text.foreground}}'
    cherryPickedCommitBgColor:
      - '{{colors.dim.purple}}'
    cherryPickedCommitFgColor:
      - '{{colors.accents.cyan}}'
    unstagedChangesColor:
      - '{{colors.accents.red}}'
    stagedChangesColor:
      - '{{colors.accents.green}}'
    markedBaseCommitFgColor:
      - '{{colors.accents.yellow}}'
    markedBaseCommitBgColor:
      - '{{colors.dim.yellow}}'
    defaultFgColor:
      - '{{colors.text.foreground}}'
  showIcons: true
  nerdFontsVersion: "3"
git:
  diffRenderers:
    - colorArg: always
      command: delta --dark --paging=never --line-numbers
