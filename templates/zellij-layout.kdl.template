// Generated from palette.json. Do not edit generated output manually.
layout {
    pane
    pane size=1 borderless=true {
        plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
            // Layout general
            format_left   "{mode} {tabs}"
            format_right  "#[bg={{colors.base.card}},fg={{colors.accents.cyan}},bold]  {session} #[bg={{colors.base.cardHover}},fg={{colors.text.foreground}}]  {datetime} "
            format_space  " "

            format_hide_on_overlength "true"
            format_precedence "lrc"

            border_enabled  "false"

            // Modos con estilo Static Noise (Cian foco para normal, semántica de estados)
            mode_normal        "#[bg={{colors.accents.cyan}},fg={{colors.base.void}},bold]  NORMAL #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_locked        "#[bg={{colors.accents.red}},fg={{colors.base.void}},bold]  LOCKED #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_pane          "#[bg={{colors.accents.blue}},fg={{colors.base.void}},bold]  PANE #[bg={{colors.base.cardHover}},fg={{colors.accents.blue}}]  #[fg={{colors.accents.cyan}},bold]n#[fg={{colors.text.foreground}}]:new #[fg={{colors.accents.cyan}},bold]d#[fg={{colors.text.foreground}}]:down #[fg={{colors.accents.cyan}},bold]r#[fg={{colors.text.foreground}}]:right #[fg={{colors.accents.red}},bold]x#[fg={{colors.text.foreground}}]:close #[fg={{colors.accents.yellow}},bold]f#[fg={{colors.text.foreground}}]:full #[fg={{colors.accents.purple}},bold]w#[fg={{colors.text.foreground}}]:float #[fg={{colors.accents.blue}},bold]z#[fg={{colors.text.foreground}}]:frames #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_tab           "#[bg={{colors.accents.purple}},fg={{colors.base.void}},bold]  TAB #[bg={{colors.base.cardHover}},fg={{colors.accents.purple}}]  #[fg={{colors.accents.cyan}},bold]n#[fg={{colors.text.foreground}}]:new #[fg={{colors.accents.red}},bold]x#[fg={{colors.text.foreground}}]:close #[fg={{colors.accents.cyan}},bold]h/l#[fg={{colors.text.foreground}}]:move #[fg={{colors.accents.yellow}},bold]r#[fg={{colors.text.foreground}}]:rename #[fg={{colors.accents.green}},bold]s#[fg={{colors.text.foreground}}]:sync #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_resize        "#[bg={{colors.accents.orange}},fg={{colors.base.void}},bold]  RESIZE #[bg={{colors.base.cardHover}},fg={{colors.accents.orange}}]  #[fg={{colors.accents.cyan}},bold]+/-#[fg={{colors.text.foreground}}]:size #[fg={{colors.accents.cyan}},bold]h/j/k/l#[fg={{colors.text.foreground}}]:dir #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_scroll        "#[bg={{colors.accents.green}},fg={{colors.base.void}},bold]  SCROLL #[bg={{colors.base.cardHover}},fg={{colors.accents.green}}]  #[fg={{colors.accents.cyan}},bold]j/k#[fg={{colors.text.foreground}}]:scroll #[fg={{colors.accents.cyan}},bold]d/u#[fg={{colors.text.foreground}}]:page #[fg={{colors.accents.yellow}},bold]s#[fg={{colors.text.foreground}}]:search #[fg={{colors.accents.green}},bold]e#[fg={{colors.text.foreground}}]:edit #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_session       "#[bg={{colors.accents.magenta}},fg={{colors.base.void}},bold]  SESSION #[bg={{colors.base.cardHover}},fg={{colors.accents.magenta}}]  #[fg={{colors.accents.red}},bold]d#[fg={{colors.text.foreground}}]:detach #[fg={{colors.accents.cyan}},bold]w#[fg={{colors.text.foreground}}]:manager #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_move          "#[bg={{colors.accents.yellow}},fg={{colors.base.void}},bold]  MOVE #[bg={{colors.base.cardHover}},fg={{colors.accents.yellow}}]  #[fg={{colors.accents.cyan}},bold]h/j/k/l#[fg={{colors.text.foreground}}]:move pane #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_search        "#[bg={{colors.accents.green}},fg={{colors.base.void}},bold]  SEARCH #[bg={{colors.base.cardHover}},fg={{colors.accents.green}}]  #[fg={{colors.accents.cyan}},bold]n/p#[fg={{colors.text.foreground}}]:next/prev #[fg={{colors.accents.yellow}},bold]c#[fg={{colors.text.foreground}}]:case #[fg={{colors.accents.green}},bold]w#[fg={{colors.text.foreground}}]:wrap #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"
            mode_tmux          "#[bg={{colors.accents.orange}},fg={{colors.base.void}},bold]  TMUX #[bg={{colors.base.void}},fg={{colors.text.foreground}}]"

            // Pestañas (con píldora cian/cyanDim para la activa)
            tab_normal              "#[bg={{colors.base.card}},fg={{colors.text.muted}}] {index} #[bg={{colors.base.cardHover}},fg={{colors.text.soft}}] {name} #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "
            tab_normal_fullscreen   "#[bg={{colors.base.card}},fg={{colors.text.muted}}] {index} #[bg={{colors.base.cardHover}},fg={{colors.text.soft}}] {name} #[fg={{colors.accents.purple}}] #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "
            tab_normal_sync         "#[bg={{colors.base.card}},fg={{colors.text.muted}}] {index} #[bg={{colors.base.cardHover}},fg={{colors.text.soft}}] {name} #[fg={{colors.accents.green}}] #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "
            
            tab_active              "#[bg={{colors.dim.cyan}},fg={{colors.text.foreground}},bold] {index} #[bg={{colors.accents.cyan}},fg={{colors.base.void}},bold] {name} #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "
            tab_active_fullscreen   "#[bg={{colors.dim.cyan}},fg={{colors.text.foreground}},bold] {index} #[bg={{colors.accents.purple}},fg={{colors.base.void}},bold] {name}  #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "
            tab_active_sync         "#[bg={{colors.dim.cyan}},fg={{colors.text.foreground}},bold] {index} #[bg={{colors.accents.green}},fg={{colors.base.void}},bold] {name}  #[bg={{colors.base.void}},fg={{colors.text.foreground}}] "

            // Hora
            datetime          "#[fg={{colors.text.foreground}},bold]{format}"
            datetime_format   "%H:%M"
            datetime_timezone "local"
        }
    }
}
