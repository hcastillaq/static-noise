# Static Noise colors for bottom (0.14+)
# Generated from palette.json. Do not edit generated output manually.

[styles.tables]
headers = { color = "{{colors.accents.cyan}}", bold = true }

[styles.cpu]
all_entry_color = "{{colors.accents.purple}}"
avg_entry_color = "{{colors.accents.red}}"
cpu_core_colors = ["{{colors.accents.cyan}}", "{{colors.accents.blue}}", "{{colors.accents.green}}", "{{colors.accents.yellow}}", "{{colors.accents.orange}}", "{{colors.accents.purple}}"]

[styles.memory]
ram_color = "{{colors.accents.green}}"
swap_color = "{{colors.accents.orange}}"

[styles.network]
rx_color = "{{colors.accents.cyan}}"
tx_color = "{{colors.accents.purple}}"

[styles.battery]
high_battery_color = "{{colors.accents.green}}"
medium_battery_color = "{{colors.accents.yellow}}"
low_battery_color = "{{colors.accents.red}}"

[styles.graphs]
graph_color = "{{colors.text.dim}}"

[styles.widgets]
border_color = "{{colors.base.borderStrong}}"
selected_border_color = "{{colors.accents.cyan}}"
widget_title = { color = "{{colors.accents.cyan}}" }
text = { color = "{{colors.text.foreground}}" }
selected_text = { color = "{{colors.text.foreground}}", bg_color = "{{colors.dim.cyan}}" }
disabled_text = { color = "{{colors.text.dim}}" }
